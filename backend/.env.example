PORT=4000
HOST=0.0.0.0
SHUTDOWN_TIMEOUT_MS=10000
NODE_ENV=development

# Connection string de tu proyecto Neon/Supabase (Postgres en la nube)
# Ejemplo Neon: postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Neon/Supabase requieren SSL (true por defecto). Pon "false" solo si usas
# un Postgres local sin SSL (ej. docker-compose) para desarrollo.
DB_SSL=true

# Secreto para firmar los JWT. Genera uno propio, no uses este valor en producción.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (servidor de desarrollo de Vite)
# Separa varios orígenes con comas. En producción es obligatorio.
CORS_ORIGIN=http://127.0.0.1:5173

# Número de proxies confiables entre internet y Express. Déjalo vacío cuando
# el backend recibe tráfico directamente.
TRUST_PROXY_HOPS=

# Solo para cargar los datos ficticios en desarrollo. No se permite ejecutar
# el seeder de demostración con NODE_ENV=production.
DEMO_SEED_PASSWORD=
